# Database Configuration (External PostgreSQL)
DATABASE_NAME=uscis_forms
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_postgres_password_here
DATABASE_PORT=5432

# Mailgun Configuration (REQUIRED; read by the Processor and Web services)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=USCIS Form Tracker
MAILGUN_MAILING_LIST_ADDRESS=your_mailing_list@yourdomain.com

# Cloudflare Tunnel (REQUIRED for the cloudflared service)
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel
# Set the tunnel's public hostname to route to http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# USCIS Configuration
USCIS_FORMS_PAGE_URL=https://www.uscis.gov/forms/all-forms

# PDF Storage Configuration
# Root directory where downloaded PDFs are stored
# (docker-compose sets the root to /app/forms, backed by the forms_data volume)
PDF_STORAGE_ROOT_DIR=forms
# Number of PDF versions to keep per form (older versions are deleted)
PDF_STORAGE_KEEP_VERSIONS=10

# Quartz Scheduler Configuration
# Cron format: second minute hour day month dayOfWeek
# Default: Run every day at 2:00 AM
QUARTZ_CRON_SCHEDULE=0 0 2 * * ?

# Application Environment
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information
